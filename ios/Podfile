# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
else
  # For Firebase and RN 0.83 New Arch compatibility
  use_frameworks! :linkage => :static
end

target 'FlyBook' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Google Maps dependencies for react-native-maps
  pod 'react-native-maps', :path => '../node_modules/react-native-maps', :subspecs => [
    'Maps',
    'Google'
  ]

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Custom post-install configurations to resolve compilation issues
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # 1. Allow non-modular includes in framework modules (fixes PromisesObjC errors with static linkage)
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'

        # 2. Fix Xcode 26 (iOS 26 SDK) compatibility — disable warnings-as-errors for all pods
        # Xcode 26 Clang flags some patterns as return-type errors that older SDK didn't catch
        config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
        config.build_settings['SWIFT_TREAT_WARNINGS_AS_ERRORS'] = 'NO'

        # 3. Fix Xcode C++20 consteval compilation errors in fmt & RCT-Folly
        if target.name == 'fmt' || target.name == 'RCT-Folly'
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'FMT_USE_CONSTEVAL=0'
        end
      end
    end

    # 4. Fix 'GoogleMaps framework not found' linker error with static linkage + XCFramework
    # GoogleMaps ships as a pre-built XCFramework; we must tell the linker where to find it.
    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.user_project.targets.each do |target|
        target.build_configurations.each do |config|
          # Add the path where CocoaPods copies XCFramework slices during build
          config.build_settings['FRAMEWORK_SEARCH_PATHS'] ||= ['$(inherited)']
          config.build_settings['FRAMEWORK_SEARCH_PATHS'] << '$(BUILT_PRODUCTS_DIR)'
          config.build_settings['FRAMEWORK_SEARCH_PATHS'] << '$(BUILT_PRODUCTS_DIR)/GoogleMaps'
          config.build_settings['FRAMEWORK_SEARCH_PATHS'] << '${PODS_ROOT}/GoogleMaps/Maps/Frameworks'
        end
      end
      aggregate_target.user_project.save
    end
  end
end
